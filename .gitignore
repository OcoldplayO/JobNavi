# ============ Root-level: project-wide ignores ============
# (backend/ and frontend/ have their own .gitignore for subdir specifics)

# Backend: build output & local config
backend/target/
backend/**/application-local.properties

# Frontend: dependencies & build
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel
frontend/.pnp
frontend/.pnp.js

# IDE / Editor (IntelliJ, VS Code, etc.)
.idea/
*.iml
.vscode/
*.code-workspace

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*.log

# Env & secrets (never commit)
.env
.env.local
.env.*.local
*.pem

# Project docs (local reference only, exclude README for future use)
*.md
!README.md
